{:paths ["src" "resources"]
 :deps  {org.clojure/clojure                       {:mvn/version "1.12.5"}
         ;; cljs only: picks the Node, browser, or other adapter
         io.github.paintparty/js-runtime-detection {:mvn/version "0.1.0-SNAPSHOT"}}
 :aliases
 {;; ClojureScript for `bb test:browser`
  :cljs-latest {:extra-paths ["test-browser"]
                :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.145"}}}
  :test      {:extra-paths ["test"]
              :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.3"}
                            io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                                  :git/sha "dfb30dd"}}}
  :jolt-test {:extra-paths ["test"]
              :extra-deps  {io.github.cognitect-labs/test-runner
                            {:git/tag "v0.5.1"
                             :git/sha "dfb30dd"}
                            org.clojure/test.check
                            {:mvn/version "1.1.3"}}
              :main-opts   ["-m" "cognitect.test-runner"]}
  ;; Clojure version overrides for the compatibility floor. Combine with :test,
  ;; e.g. `clojure -M:1.10:test -m cognitect.test-runner`. Driven by `bb test:compat`.
  :1.9       {:override-deps {org.clojure/clojure {:mvn/version "1.9.0"}}}
  :1.10      {:override-deps {org.clojure/clojure {:mvn/version "1.10.3"}}}
  :1.11      {:override-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :build     {:deps       {io.github.clojure/tools.build
                           {:mvn/version "0.10.14"}
                           slipset/deps-deploy           {:mvn/version "0.2.5"}}
              :ns-default build}}}
